#!/command/with-contenv sh
# Garante estado Watson, mcp_servers.watson e skills.platform_disabled no config do home.
# Roda após 00-plow-sanitize. Nunca fatal: falha aqui não derruba o gateway.
#
# Roda como root num home gravável pelo agente (uid 10000): nunca seguir um
# symlink que ele possa ter plantado (-L guards), e editar config.yaml COMO
# hermes (s6-setuidgid), como o plow-init faz.
set -eu

PYTHON=${WATSON_PYTHON:-/opt/hermes/.venv/bin/python}
HOME_DIR=${HERMES_HOME:-/var/lib/hermes}
WATSON_HOME=${WATSON_HOME:-$HOME_DIR/watson}
CONFIG=${HOME_DIR}/config.yaml
OVERLAY=/opt/watson-triage/mcp-watson.yaml
MERGE=/opt/watson-triage/watson-config-merge.py

if [ -L "$WATSON_HOME" ]; then
  echo "watson-mcp: skip home setup ($WATSON_HOME is a symlink)" >&2
else
  if [ ! -e "$WATSON_HOME" ]; then
    install -d -o 10000 -g 10000 -m 0700 "$WATSON_HOME" || true
  fi
  # Hermes runs MCP as uid 10000. Root docker-exec can leave root-owned 0600 files
  # that make watson_status fail with PermissionError — reclaim ownership each boot.
  # chown -R without -H/-L never follows symlinks inside the tree.
  chown -R 10000:10000 "$WATSON_HOME" 2>/dev/null || true
  chmod 0700 "$WATSON_HOME" 2>/dev/null || true
  for private in memory.sqlite worker.lock config.json; do
    if [ -f "$WATSON_HOME/$private" ] && [ ! -L "$WATSON_HOME/$private" ]; then
      chmod 0600 "$WATSON_HOME/$private" 2>/dev/null || true
    fi
  done
fi
# Same for Codex/Claude CLI state: a root `codex` run leaves root-owned tmp dirs.
for cli_dir in "$HOME_DIR/.codex" "$HOME_DIR/.claude"; do
  if [ -d "$cli_dir" ] && [ ! -L "$cli_dir" ]; then
    chown -R 10000:10000 "$cli_dir" 2>/dev/null || true
  fi
done

if [ ! -f "$CONFIG" ] || [ ! -f "$OVERLAY" ] || [ ! -x "$PYTHON" ] || [ ! -f "$MERGE" ]; then
  echo "watson-mcp: skip merge (config/overlay/python ausente)" >&2
  exit 0
fi

if ! /command/s6-setuidgid hermes "$PYTHON" "$MERGE" "$CONFIG" "$OVERLAY"; then
  echo "watson-mcp: merge falhou; gateway segue sem bloco watson" >&2
  exit 0
fi
