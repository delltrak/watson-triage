#!/command/with-contenv sh
# Garante estado Watson e entrada mcp_servers.watson no config do home.
# Roda após 00-plow-sanitize. Nunca fatal: falha aqui não derruba o gateway.
set -eu

PYTHON=${WATSON_PYTHON:-/opt/hermes/.venv/bin/python}
HOME_DIR=${HERMES_HOME:-/var/lib/hermes}
WATSON_HOME=${WATSON_HOME:-$HOME_DIR/watson}
CONFIG=${HOME_DIR}/config.yaml
OVERLAY=/opt/watson-triage/mcp-watson.yaml

install -d -o 10000 -g 10000 -m 0700 "$WATSON_HOME" || true

if [ ! -f "$CONFIG" ] || [ ! -f "$OVERLAY" ] || [ ! -x "$PYTHON" ]; then
  echo "watson-mcp: skip merge (config/overlay/python ausente)" >&2
  exit 0
fi

if ! "$PYTHON" - "$CONFIG" "$OVERLAY" <<'PY'
from pathlib import Path
import sys
import yaml

config_path = Path(sys.argv[1])
overlay_path = Path(sys.argv[2])
data = yaml.safe_load(config_path.read_text()) or {}
overlay = yaml.safe_load(overlay_path.read_text()) or {}
watson = (overlay.get("mcp_servers") or {}).get("watson")
if not watson:
    raise SystemExit(0)
servers = data.setdefault("mcp_servers", {})
if servers.get("watson") == watson:
    raise SystemExit(0)
servers["watson"] = watson
tmp = config_path.with_suffix(".yaml.watson-tmp")
tmp.write_text(yaml.safe_dump(data, sort_keys=False, allow_unicode=True))
tmp.chmod(config_path.stat().st_mode & 0o777)
# Preserve ownership when possible.
import os
st = config_path.stat()
os.chown(tmp, st.st_uid, st.st_gid)
tmp.replace(config_path)
print("watson-mcp: mcp_servers.watson atualizado", flush=True)
PY
then
  echo "watson-mcp: merge falhou; gateway segue sem bloco watson" >&2
  exit 0
fi
