#!/command/with-contenv sh
# One Watson cycle every ten minutes, from boot.
#
# A supervised loop rather than a timer: this image is supervised by s6, and
# that is the shape a periodic job takes under it. Ten minutes because an issue
# assignment is not urgent and each pass costs a GitHub read per tracked issue;
# `cycle` is resumable and skips an issue whose event cursor has not moved, so a
# late or missed tick costs nothing.

# Absolute, because a service inherits the supervision tree's PATH and not a
# login shell's -- `gh` resolving at all would otherwise be a property of the
# init's configuration rather than of this file.
PATH=/command:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
export PATH

WATSON_HOME=/var/lib/hermes/watson
# The owner's GitHub tokens for the Watson Triage app, in a directory root owns
# 0700, outside the agent's home. Only $AUTH, run here as root, touches it.
STORE=/var/lib/watson-github
AUTH='/opt/hermes/.venv/bin/python3 -I -m watson.githubapp'

# The token never comes from the container environment, from a file the agent
# writes, or from the conversation. Each of those once put a credential in
# model context: an agent-written file sourced here was root execution one
# prompt injection away, a token the owner had to type reached the inference
# provider the moment it was said, and anything in the container environment
# is one `printenv` from the gateway's shell, which shares this container. The
# owner approves a device code at github.com instead; the code is not a
# secret, and the tokens stay root's.
#
# HOME is an empty directory root owns, never the agent's: `gh` reads
# $HOME/.config/gh/config.yml, and an `http_unix_socket` the agent wrote there
# sends "Authorization: token $GH_TOKEN" to a socket it listens on, every pass.
# HOME rather than GH_CONFIG_DIR, so every reader anchored on it is covered;
# set, never unset, because unset falls back to the passwd home, which the
# agent owns. `env -i` is what keeps it that way: it clears GH_CONFIG_DIR and
# the XDG_* variables, which would otherwise override it.
#
# Residual, named here and in issue #2: the child below runs as `hermes`, the
# gateway's own uid, so its /proc entry -- the token with it -- is readable for
# as long as a pass runs: minutes when an issue changed. That is the access
# token alone; the refresh token never leaves $AUTH.
cycle() {
  /command/s6-setuidgid hermes env -i \
    PATH="$PATH" HOME=/opt/watson/cycle-home \
    PLOW_API_BASE="$PLOW_API_BASE" \
    PLOW_AGENT_TOKEN="$PLOW_AGENT_TOKEN" \
    HERMES_CUSTOM_PLOW_API_KEY="$HERMES_CUSTOM_PLOW_API_KEY" \
    GH_TOKEN="$GH_TOKEN" \
    ${TZ:+TZ="$TZ"} \
    /opt/hermes/.venv/bin/watson --home "$WATSON_HOME" cycle
}

# On shutdown, stop starting NEW passes -- do NOT kill a running one.
#
# `cycle` commits the case cursor before delivering, deliberately, so an
# uncertain send is never blindly replayed. Killing the child mid-pass can
# therefore land between that commit and the send, and the next cycle reads the
# cursor as unchanged and never retries: one routine `compose stop` silently
# eats an issue update. That is the exact loss the checkpoint ordering exists
# to prevent, so the trap must not introduce it.
#
# An in-flight pass is left to finish or to be SIGKILLed at the end of the
# container's grace period, and that is not clean yet (issue #9). The pass is
# never told to stop, so it keeps starting new issues after SIGTERM; and a send
# it is killed in stays `sending`, because the handler that records `unknown`
# never runs. `exit 0` is deferred until the foreground child returns:
# immediate while idle, after the pass while one is running, and after root's
# `prepare` while it runs -- a slow refresh, or a device flow asked for in the
# instant before the tick, can hold shutdown past the grace period.
#
# Idle is a backgrounded $waiter, and the trap stops it as well: s6 signals only
# this script, and a waiter left behind would go on answering the owner and
# refreshing the token beside the loop that replaces this one.
trap 'kill $waiter 2>/dev/null; exit 0' TERM INT

# Ten minutes, backgrounded and waited rather than in the foreground: a trap
# does not interrupt a foreground child, so shutdown would stall until the
# grace period SIGKILLed us. `wait` returns as soon as the handler runs.
# Meanwhile $AUTH answers a connect request within seconds, and still returns
# only at the tick, so asking again buys no pass. If it fails instead -- an
# image built without the app, say, which it reports -- the rest is a plain
# sleep, so the loop never spins.
pause() {
  $AUTH wait 600 & waiter=$!
  wait $waiter && return
  /bin/sleep 600 & waiter=$!
  wait $waiter || true
}

while :; do
  # Tested by doing, not by reading the mode. If the agent's uid can so much as
  # enter $STORE -- a host directory mounted over it, say, and Docker Desktop on
  # macOS enforces no mode there at all -- a prompt injection can read the
  # tokens or plant a link for root to write through. So this refuses before
  # $AUTH has put anything there, and pauses with a plain sleep, which answers
  # no connect request.
  if /command/s6-setuidgid hermes test -x "$STORE"; then
    echo "watson-cycle: REFUSING to run -- the agent's own uid can enter $STORE," >&2
    echo "so a prompt injection could read the GitHub tokens. Mount nothing there." >&2
    /bin/sleep 600 & waiter=$!; wait $waiter || true
    continue
  fi

  # As root: answer the owner's connect request, refresh a token near expiry --
  # here, between passes, because a refresh retires the token it replaces at
  # once -- and print the access token for this pass, or nothing. With
  # nothing, a configured install still runs the pass: gh refuses at once,
  # with no network call (exit 4, read as a 401), and the pass tells the owner
  # once, as for any 401. Standing down here instead left the owner unaware
  # when root dropped a token GitHub had refused.
  GH_TOKEN=$($AUTH prepare) || GH_TOKEN=

  if [ ! -f "$WATSON_HOME/config.json" ]; then
    # Not an error: a fresh agent has not been through watson-setup yet, and
    # there is nothing here to poll for -- the owner finishes it in chat.
    echo "watson-cycle: not configured yet; the owner runs watson-setup in chat" >&2
    pause
    continue
  fi

  # The pass's JSON goes to the log, not /dev/null. `cycle` catches per-issue
  # failures and returns them in that JSON rather than raising, so discarding
  # it left the only record of what broke nowhere -- and the stderr line below
  # pointed at a journal that then held nothing.
  #
  # Never fatal. `cycle` exits 1 when any single tracked issue errored, which
  # is an ordinary outcome: one unreadable issue must not respawn this service,
  # and a crashing longrun is respawned in a tight loop.
  cycle || echo "watson-cycle: pass reported errors; see its JSON above" >&2
  pause
done
